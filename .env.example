# Copie para .env e preencha. Nunca commite o .env.

# --- Provedor de IA ------------------------------------------------------------
# falso  = respostas fixas, sem chave e sem custo (para testar a integração)
# openai = ChatGPT via API da OpenAI (gasta créditos)
# Ao trocar de provedor, rode de novo: python -m app.rag.ingestao
IA_PROVEDOR=falso

# --- OpenAI (mesmos nomes da API Java) -----------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Deixe vazio para gpt-5+/gpt-6 (só aceitam o padrão). Ex.: 0.2 para gpt-4o/gpt-4.1
OPENAI_TEMPERATURE=
# Raciocínio: none (padrão, mais rápido), minimal, low, medium, high.
# Deixe vazio para modelos sem raciocínio (gpt-4o/gpt-4.1), que não aceitam o parâmetro.
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT_S=20

# Embeddings do RAG. Trocar o modelo ou a dimensão exige rodar a ingestão de novo.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Vazio = dimensão nativa do modelo
OPENAI_EMBEDDING_DIMENSOES=

# --- RAG -------------------------------------------------------------------------
RAG_TOP_K=4
# Similaridade mínima (cosseno) para um trecho ser usado. Calibrar com a avaliação.
RAG_LIMIAR=0.40
CHUNK_MAX_CARACTERES=1500
DIR_FONTES=data/fontes
DIR_INDICE=data/indice

# --- Descrição -------------------------------------------------------------------
# Mesmos valores da API Java (veai.ia.confianca-minima e tamanho-maximo-bytes)
LIMIAR_SUGERIR_RELATO=0.70
IMAGEM_MAX_BYTES=5242880
